  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "3.10.0",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "@mui/material-nextjs": "6.5.0",
    "@tanstack/react-query": "5.62.0",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.11.0",
    "framer-motion": "11.18.2",
    "jose": "5.10.0",
    "mongoose": "8.24.10",
    "next": "15.5.29",
    "razorpay": "2.9.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
