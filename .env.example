# ---- Core ----
MONGODB_URI=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ---- Cloudinary (server-side only) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
# Use rzp_test_* keys in development. NEVER prefix secrets with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Resend HTTP API). Leave empty in dev to log emails to the console ----
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ---- Ops ----
# Shared secret for /api/cron/* endpoints (e.g. Vercel Cron: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Minutes an unpaid checkout may hold reserved stock
CHECKOUT_RESERVATION_MINUTES=20

# ---- One-time staff bootstrap (used by `npm run bootstrap:admins`; remove afterwards) ----
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
